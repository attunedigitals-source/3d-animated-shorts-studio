# ==============================================================================
# 3D ANIMATED SHORTS STUDIO — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Safe placeholders for all services, workers, and shared packages.
# Copy this file to .env in each corresponding workspace or root as needed.
# NEVER commit real credentials or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000
API_PORT=4000
WORKER_PORT=5000

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE & AUTH & STORAGE)
# ------------------------------------------------------------------------------
# Local Supabase default or hosted project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Public anon key (safe for browser client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_placeholder
# Service role key (STRICTLY BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key_placeholder
# Database direct connection string (for migrations and prisma/drizzle if used)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 3. REDIS & BULLMQ (JOB QUEUES & CACHE)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_TLS=false
# Prefix for BullMQ queues
QUEUE_PREFIX=shorts_studio

# ------------------------------------------------------------------------------
# 4. AI STORY & SCRIPT GENERATION (PROVIDER-INDEPENDENT ADAPTER)
# ------------------------------------------------------------------------------
# AI Provider: "ollama" | "openrouter" | "openai" | "anthropic" | "mock"
AI_PROVIDER=ollama
# When MOCK_AI=true, the system returns deterministic, high-quality script mocks without calling external APIs
MOCK_AI=false

# Self-Hosted Ollama Configuration (AWS EC2)
# Scenario A (API and Ollama on same EC2): http://127.0.0.1:11434
# Scenario B (API runs remotely): Secure private tunnel, VPN, or authenticated HTTPS reverse proxy (never expose raw port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional API key or bearer token if Ollama is behind an authenticated proxy
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=180000

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-example-placeholder-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
AI_REQUEST_TIMEOUT_MS=60000

# Direct OpenAI Configuration (optional fallback)
OPENAI_API_KEY=sk-proj-example-placeholder-openai-key
OPENAI_DEFAULT_MODEL=gpt-4o

# Direct Anthropic Configuration (optional fallback)
ANTHROPIC_API_KEY=sk-ant-example-placeholder-anthropic-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 5. VOICE GENERATION & TTS (AUDIO ENGINE)
# ------------------------------------------------------------------------------
# Voice Provider: "ai33" | "mock"
VOICE_PROVIDER=mock
# When MOCK_VOICE=true, the system generates synthesized test audio or local speech files
MOCK_VOICE=true

# ai33.pro Unified v3 API Configuration
# Unified voice platform supporting: elevenlabs_, minimax_, clone_, edge_, kokoro_, vbee_, and fishaudio_
AI33_API_KEY=ai33_example_placeholder_api_key
AI33_BASE_URL=https://api.ai33.pro/v3
AI33_DEFAULT_VOICE_ID=minimax_male-qn-qingse
# Webhook receive URL for async task callbacks (optional)
AI33_RECEIVE_URL=

# ------------------------------------------------------------------------------
# 6. STORAGE ADAPTER (ASSETS, RENDERS, EXPORTS)
# ------------------------------------------------------------------------------
# Storage Provider: "local" | "supabase" | "s3"
STORAGE_PROVIDER=local
# Local storage root directory (relative to repo root or absolute)
LOCAL_STORAGE_DIR=./storage_data
# Supabase storage bucket names
SUPABASE_STORAGE_BUCKET_ASSETS=studio-assets
SUPABASE_STORAGE_BUCKET_RENDERS=studio-renders
# S3 Compatible Storage (AWS / Cloudflare R2 / MinIO) - optional
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# 7. RENDERING WORKER & MEDIA PROCESSING
# ------------------------------------------------------------------------------
# Worker concurrency (number of parallel render jobs)
WORKER_CONCURRENCY=2
# Temporary directory for video frames, raw audio, and compositing caches
RENDER_TEMP_DIR=./renders/temp
# Final export output directory
RENDER_OUTPUT_DIR=./renders/output
# Chromium executable path for Remotion headless rendering (leave blank for default auto-download)
PUPPETEER_EXECUTABLE_PATH=
# Custom FFmpeg / FFprobe paths (leave blank to use system PATH or @ffmpeg-installer)
FFMPEG_PATH=
FFPROBE_PATH=
# Video rendering presets
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_VIDEO_CRF=18
DEFAULT_VIDEO_PRESET=fast

# ------------------------------------------------------------------------------
# 8. FRONTEND (VITE CLIENT PUBLIC CONFIGURATION)
# ------------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_placeholder
VITE_ENABLE_MOCK_AI=true
VITE_ENABLE_MOCK_VOICE=true
VITE_APP_NAME="3D Animated Shorts Studio"
VITE_APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 9. AWS EC2 FASTAPI + OLLAMA BACKEND (VERCEL SERVERLESS INTEGRATION)
# ------------------------------------------------------------------------------
# Server-side only (never prefix with VITE_ or expose to client)
AWS_LLM_URL=https://your-ec2-backend.amazonaws.com
YOUTUBE_API_KEY=your_fastapi_backend_api_key_placeholder


