# Pure AI 3D Animated Video Studio Environment
PORT=4000
API_PORT=4000
NODE_ENV=production

# Google Gemini API Key
# Enables deep-research-max-preview, gemini-2.5-pro, gemini-3-pro-image, gemini-4-argon, lyria-3.5, gemini-omni-1.2-flash
GEMINI_API_KEY=your_gemini_api_key_here

# ai33.pro Voice API Key
# Enables high-definition neural voice synthesis with millisecond word timestamps
AI33_API_KEY=your_ai33_api_key_here
AI33_BASE_URL=https://api.ai33.pro/v3

# Supabase Vault (Optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

